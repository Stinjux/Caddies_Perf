# CaddiePerf — variables d'environnement
# AUCUNE VALEUR REELLE dans ce fichier (principe II de la constitution).
# Copier vers .env (ignore par git) et renseigner localement.

# Base de donnees de developpement
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/caddieperf_dev

# Base de donnees de test — reinitialisee entre les series
TEST_DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/caddieperf_test

# Connexion APPLICATIVE. Le role caddieperf_app n'est NI superutilisateur NI
# proprietaire des tables : c'est la seule maniere que le RLS s'applique
# reellement — un superutilisateur le contourne toujours, en silence.
# Poser le mot de passe une fois, hors du depot :
#   ALTER ROLE caddieperf_app WITH PASSWORD '<secret>';
# EN PRODUCTION, DATABASE_URL DOIT UTILISER CE ROLE.
#
# Au deploiement, scripts/migrate.mjs pose ce mot de passe a partir de
# APP_DB_PASSWORD, puis compose APP_DATABASE_URL. Voir DEPLOIEMENT.md.
APP_DB_PASSWORD=
APP_DATABASE_URL=postgresql://caddieperf_app:motdepasse@localhost:5432/caddieperf_dev
TEST_APP_DATABASE_URL=postgresql://caddieperf_app:motdepasse@localhost:5432/caddieperf_test

# Secret de signature des cookies de session (generer avec: openssl rand -base64 32)
SESSION_SECRET=

# Duree des sessions, en heures
SESSION_TTL_HOURS_ADMIN=8
SESSION_TTL_HOURS_STARTER=24
